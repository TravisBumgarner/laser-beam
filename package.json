{
  "name": "laser-beam",
  "productName": "Laser Beam",
  "version": "0.0.3",
  "description": "A Spotlight replacement",
  "main": ".vite/build/main.cjs",
  "private": true,
  "scripts": {
    "dev": "electron-forge start",
    "package": "SHOULD_APPLE_SIGN=0 electron-forge package && open ./out",
    "lint": "npx biome check .",
    "make": "SHOULD_APPLE_SIGN=1 dotenv -e .env -- electron-forge make && open ./out",
    "publish-mac": "SHOULD_APPLE_SIGN=1 dotenv -e .env -- electron-forge publish",
    "publish": "electron-forge publish"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv-cli": "^11.1.0",
    "electron": "^45.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TravisBumgarner/laser-beam.git"
  }
}
